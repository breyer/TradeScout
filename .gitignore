# Ignore the build folder
build/

# Ignore the dist folder and all its contents
dist/

# Ignore database files (never commit personal TAT data)
*.db3
data/

# Ignore PyInstaller spec files
*.spec

# Ignore any screenshots
dist/*.png
*.png

# Ignore the real config.yaml file with sensitive information
config/config.yaml

# Ignore Python cache files
__pycache__/
*.pyc
